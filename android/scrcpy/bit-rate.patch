+    /** Orither: changes the bit rate of the running encoder, and of the ones after a reset. */
+    public synchronized void setBitRate(int bitRate) {
+        this.bitRate = bitRate;
+        if (runningMediaCodec != null) {
+            Bundle params = new Bundle();
+            params.putInt(MediaCodec.PARAMETER_KEY_VIDEO_BITRATE, bitRate);
+            try {
+                runningMediaCodec.setParameters(params);
+            } catch (IllegalStateException e) {
+                // ignore, the next encoder takes it
+            }
+        }
+    }
+
+    public synchronized int getBitRate(int initial) {
+        return bitRate != 0 ? bitRate : initial;
+    }
+
     public synchronized void setRunningMediaCodec(MediaCodec runningMediaCodec) {
